maintainer="handwritten.blog <hello@handwritten.blog>"
pkgname=handwritten-blog
pkgver=0.2.0
pkgrel=0
upstream_author="handwritten.blog"
category="utilities"
pkgdesc="Upload one explicitly selected reMarkable notebook as a private handwritten.blog draft"
url="https://github.com/emilesilvis/handwritten-blog-uploader"
arch="armv7"
license="MIT"
readmeurl="https://raw.githubusercontent.com/emilesilvis/handwritten-blog-uploader/v$pkgver/README.md"
depends="!rm1 !rmpp !rmppm !rmppure remarkable-os>=3.28.0.169 remarkable-os<3.28.0.170"
options="!fhs"

source="
$pkgname-uploader-$pkgver.tar.gz::https://github.com/emilesilvis/handwritten-blog-uploader/archive/refs/tags/v$pkgver.tar.gz
"

image="ghcr.io/toltec-dev/golang:v4.0"

build() {
	cd "$builddir"
	CGO_ENABLED=0 GOOS=linux GOARCH=arm GOARM=7 go build \
		-buildvcs=false -trimpath \
		-ldflags="-s -w -X main.version=$pkgver -X main.baseURL=https://handwritten.blog" \
		-o handwritten-blog .
}

check() {
	cd "$builddir"
	go test ./...
}

package() {
	cd "$builddir"
	install -Dm755 handwritten-blog \
		"$pkgdir/home/root/.vellum/bin/handwritten-blog"
	install -Dm644 LICENSE \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/LICENSE"
	echo "$url" > \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/SOURCES"
}

predeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		/home/root/.vellum/bin/handwritten-blog unlink || \
			echo "Could not revoke remotely; disconnect this tablet in handwritten.blog settings."
	fi
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/handwritten-blog
		rm -rf /home/root/.cache/handwritten-blog
	fi
}

sha512sums="
@SOURCE_SHA512@  handwritten-blog-uploader-0.2.0.tar.gz
"
